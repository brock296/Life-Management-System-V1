function createCompletionRateGraph() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const tz = ss.getSpreadsheetTimeZone();
  const dashboard = ss.getSheetByName(DASHBOARD_SHEET_NAME);
  const master = ss.getSheetByName(MASTER_PROJECT_TRACKER_SHEET_NAME);
  let chartDataSheet = ss.getSheetByName(CHART_DATA_SHEET_NAME);
  if (!chartDataSheet) {
    chartDataSheet = ss.insertSheet(CHART_DATA_SHEET_NAME);
    chartDataSheet.hideSheet();
  }
  if (!dashboard || !master) return;

  const mCols = getColumnMap(master);
  const mData = getSheetDataSafe(master);
  const weekMap = new Map();

  mData.forEach(row => {
    const added = row[mCols['Date Added']];
    const status = String(row[mCols['Status']] || "").trim();
    if (added instanceof Date) {
      const weekStart = new Date(added);
      weekStart.setDate(weekStart.getDate() - weekStart.getDay());
      const key = Utilities.formatDate(weekStart, tz, "yyyy-MM-dd");
      if (!weekMap.has(key)) weekMap.set(key, { total: 0, done: 0, date: weekStart });
      const w = weekMap.get(key);
      w.total++;
      if (status === "✅ Done") w.done++;
    }
  });

  const chartData = Array.from(weekMap.values())
    .map(w => [w.date, w.total > 0 ? Math.round((w.done / w.total) * 100) : 0])
    .sort((a, b) => a[0] - b[0]);
  chartData.unshift(['Date', 'Completion Rate (%)']);

  if (chartData.length > 1) {
    chartDataSheet.getRange(1, 5, chartData.length, 2).setValues(chartData);
    const chart = dashboard.newChart()
      .setChartType(Charts.ChartType.LINE)
      .addRange(chartDataSheet.getRange(1, 5, chartData.length, 2))
      .setOption('title', 'Weekly Completion Rate')
      .setPosition(140, 1, 0, 0)
      .build();
    dashboard.insertChart(chart);
  }
}

