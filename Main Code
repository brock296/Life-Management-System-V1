function syncDailyLogToMaster(dailyLog, master, dCols, mCols, dropdowns) {
  Logger.log("--- Sync Daily Log → Master ---");
  const dData = getSheetDataSafe(dailyLog);
  const mData = getSheetDataSafe(master);
  const newTasks = [];

  const mMap = new Map();
  mData.forEach((r, i) => {
    const t = String(r[mCols['Task']] || "").trim();
    if (t) mMap.set(t, { idx: i, row: r });
  });

  let mModified = false;

  dData.forEach(dRow => {
    const taskName = String(dRow[dCols['Task']] || "").trim();
    if (!taskName) return;

    const mEntry = mMap.get(taskName);
    if (mEntry) {
      const mRow = mData[mEntry.idx];
      let changed = false;
      ['Date Added', 'Life Area', 'Project', 'Due Date', 'Status', 'Goal Name', 'Priority', 'Carry Over?'].forEach(field => {
        const dVal = dRow[dCols[field]];
        const mVal = mRow[mCols[field]];
        let newVal = dVal;
        if (field === 'Due Date') newVal = parseDate(dVal) || dVal;
        else if (['Life Area', 'Project', 'Status', 'Goal Name'].includes(field))
          newVal = validateAndGetValue(dVal, field, dropdowns) || dVal;
        if (field === 'Status' && !newVal) newVal = "To Do";
        if (field === 'Priority' && !newVal) newVal = "P4";
        if (field === 'Carry Over?' && !newVal) newVal = false;
        if (newVal !== undefined && newVal !== mVal) {
          mRow[mCols[field]] = newVal;
          changed = true;
        }
      });
      if (changed) mModified = true;
    } else {
      const newRow = new Array(master.getLastColumn()).fill("");
      newRow[mCols['Task ID']] = Utilities.getUuid();
      newRow[mCols['Date Added']] = parseDate(dRow[dCols['Date Added']]) || new Date();
      newRow[mCols['Task']] = taskName;
      newRow[mCols['Due Date']] = parseDate(dRow[dCols['Due Date']]) || null;
      newRow[mCols['Life Area']] = validateAndGetValue(dRow[dCols['Life Area']], 'Life Area', dropdowns);
      newRow[mCols['Project']] = validateAndGetValue(dRow[dCols['Project']], 'Project', dropdowns);
      newRow[mCols['Status']] = validateAndGetValue(dRow[dCols['Status']], 'Status', dropdowns) || "To Do";
      newRow[mCols['Goal Name']] = validateAndGetValue(dRow[dCols['Goal Name']], 'Goal Name', dropdowns);
      newRow[mCols['Priority']] = validateAndGetValue(dRow[dCols['Priority']], 'Priority', dropdowns) || "P4";
      newRow[mCols['Carry Over?']] = dRow[dCols['Carry Over?']] || false;
      newTasks.push(newRow);
    }
  });

  if (mModified && mData.length > 0) master.getRange(2, 1, mData.length, mData[0].length).setValues(mData);
  if (newTasks.length > 0) {
    const nextRow = getNextEmptyRow(master);
    master.getRange(nextRow, 1, newTasks.length, newTasks[0].length).setValues(newTasks);
  }
  Logger.log(`Master sync: ${newTasks.length} new, ${mModified ? 'updated' : 'no updates'}.`);
}

function syncMasterToDailyLog(dailyLog, master, dCols, mCols, dropdowns, tz) {
  Logger.log("--- Sync Master → Daily Log ---");
  const mData = getSheetDataSafe(master);
  const dData = getSheetDataSafe(dailyLog);
  const newTasks = [];
  const existing = new Set(dData.map(r => String(r[dCols['Task']] || "").trim()));
  const today = Utilities.formatDate(new Date(), tz, "yyyy-MM-dd");

  mData.forEach(mRow => {
    const task = String(mRow[mCols['Task']] || "").trim();
    const due = parseDate(mRow[mCols['Due Date']]);
    const status = String(mRow[mCols['Status']] || "").trim();
    if (task && due && Utilities.formatDate(due, tz, "yyyy-MM-dd") === today && status !== "✅ Done" && !existing.has(task)) {
      const dRow = new Array(dailyLog.getLastColumn()).fill("");
      dRow[dCols['Date Added']] = parseDate(mRow[mCols['Date Added']]) || new Date();
      dRow[dCols['Life Area']] = validateAndGetValue(mRow[mCols['Life Area']], 'Life Area', dropdowns);
      dRow[dCols['Project']] = validateAndGetValue(mRow[mCols['Project']], 'Project', dropdowns);
      dRow[dCols['Task']] = task;
      dRow[dCols['Status']] = validateAndGetValue(status, 'Status', dropdowns) || "To Do";
      dRow[dCols['Due Date']] = due;
      dRow[dCols['Priority']] = validateAndGetValue(mRow[mCols['Priority']], 'Priority', dropdowns) || "P4";
      dRow[dCols['Goal Name']] = validateAndGetValue(mRow[mCols['Goal Name']], 'Goal Name', dropdowns);
      dRow[dCols['Carry Over?']] = mRow[mCols['Carry Over?']] || false;
      newTasks.push(dRow);
    }
  });

  if (newTasks.length > 0) {
    const nextRow = getNextEmptyRow(dailyLog);
    dailyLog.getRange(nextRow, 1, newTasks.length, dailyLog.getLastColumn()).setValues(newTasks);
    Logger.log(`Added ${newTasks.length} tasks to Daily Log.`);
  }
}

function logAndCarryOverOverdueTasks(dailyLog, overdueLog, dCols, oCols, tz, dropdowns) {
  Logger.log("--- Logging overdue tasks ---");
  const dData = getSheetDataSafe(dailyLog);
  const today = new Date();
  today.setHours(0, 0, 0, 0);
  const overdueRows = [];
  let count = 0;

  dData.forEach((row, i) => {
    const due = row[dCols['Due Date']];
    const status = String(row[dCols['Status']] || "").trim();
    if (due instanceof Date && due < today && status !== "✅ Done") {
      count++;
      const newRow = [...row];
      newRow[dCols['Due Date']] = new Date();
      newRow[dCols['Carry Over?']] = true;
      overdueRows.push({ rowNum: i + 2, data: newRow });

      const logRow = new Array(overdueLog.getLastColumn()).fill("");
      ['Date Added', 'Life Area', 'Project', 'Task', 'Due Date', 'Status'].forEach(header => {
        const dIdx = dCols[header];
        const oIdx = oCols[header];
        if (dIdx !== undefined && oIdx !== undefined) {
          const val = row[dIdx];
          logRow[oIdx] = ['Life Area', 'Project', 'Status'].includes(header) ? validateAndGetValue(val, header, dropdowns) : val;
        }
      });
      if (overdueLog) overdueLog.appendRow(logRow);
    }
  });

  overdueRows.forEach(({ rowNum, data }) => {
    dailyLog.getRange(rowNum, 1, 1, data.length).setValues([data]);
    dailyLog.getRange(rowNum, 1, 1, dailyLog.getLastColumn()).setBackground("#ea9999");
  });

  Logger.log(`Overdue count: ${count}`);
  return { count, tasks: overdueRows };
}

function autoPopulateGoals(goalsSheet, goalsColumns, masterSheet, masterColumns) {
  Logger.log("--- Auto-populating Goals ---");
  const masterData = getSheetDataSafe(masterSheet);
  const goalsData = getSheetDataSafe(goalsSheet);
  const goalsMap = new Map();
  goalsData.forEach((row, i) => {
    const name = String(row[goalsColumns['Goal Name']] || "").trim();
    if (name) goalsMap.set(name, { idx: i + 2, row });
  });

  const goalStats = new Map();
  masterData.forEach(row => {
    const goal = String(row[masterColumns['Goal Name']] || "").trim();
    const status = String(row[masterColumns['Status']] || "").trim();
    if (goal) {
      if (!goalStats.has(goal)) goalStats.set(goal, { total: 0, done: 0 });
      const gs = goalStats.get(goal);
      gs.total++;
      if (status === "✅ Done") gs.done++;
    }
  });

  const newGoalRows = [];
  const updatedGoalRows = [];

  goalStats.forEach(({ total, done }, goalName) => {
    const progress = total > 0 ? done / total : 0;
    if (goalsMap.has(goalName)) {
      const existing = goalsMap.get(goalName);
      existing.row[goalsColumns['Progress']] = progress;
      updatedGoalRows.push(existing);
    } else {
      const newRow = new Array(goalsSheet.getLastColumn()).fill("");
      newRow[goalsColumns['Goal Name']] = goalName;
      newRow[goalsColumns['Progress']] = progress;
      if (goalsColumns['Date Added'] !== undefined) newRow[goalsColumns['Date Added']] = new Date();
      const first = masterData.find(r => String(r[masterColumns['Goal Name']] || "").trim() === goalName);
      if (first) {
        if (goalsColumns['Linked Life Area'] !== undefined) newRow[goalsColumns['Linked Life Area']] = first[masterColumns['Life Area']] || "";
        if (goalsColumns['Linked Project'] !== undefined) newRow[goalsColumns['Linked Project']] = first[masterColumns['Project']] || "";
      }
      newGoalRows.push(newRow);
    }
  });

  updatedGoalRows.forEach(g => goalsSheet.getRange(g.idx, 1, 1, g.row.length).setValues([g.row]));
  if (newGoalRows.length > 0) {
    const startRow = getNextEmptyRow(goalsSheet);
    goalsSheet.getRange(startRow, 1, newGoalRows.length, newGoalRows[0].length).setValues(newGoalRows);
  }
  applyAestheticTheme(GOALS_SHEET_NAME);
}

function updateDashboard(ss, dailyLog, dashboard, overdueLog, chartData, dCols, oCols, tz, overdueSummary) {
  Logger.log("--- Updating Dashboard ---");
  try {
    dashboard.clearContents().clearFormats();
    dashboard.getCharts().forEach(c => dashboard.removeChart(c));
  } catch (e) {
    Logger.log("Dashboard clear error: " + e.message);
  }

  let row = 1;
  dashboard.getRange(row, 1).setValue("Dashboard").setFontSize(16).setFontWeight("bold");
  row += 2;
  dashboard.getRange(row, 1).setValue("Today's Overdue Count:").setFontWeight("bold");
  dashboard.getRange(row, 2).setValue(overdueSummary.count).setFontWeight("bold")
    .setBackground(overdueSummary.count > 0 ? "#ea9999" : "#b6d7a8");
  row += 2;
  dashboard.getRange(row, 1).setValue("Today's Tasks").setFontSize(14).setFontWeight("bold");
  row++;

  const dailyData = getSheetDataSafe(dailyLog);
  const dispHeaders = ["Date Added", "Life Area", "Project", "Task", "Status", "Due Date", "Priority", "Goal Name"];
  const validHeaders = dispHeaders.filter(h => dCols[h] !== undefined);
  const dispIdx = validHeaders.map(h => dCols[h]);
  const todayFmt = Utilities.formatDate(new Date(), tz, "yyyy-MM-dd");

  const todayTasks = dailyData.filter(r => {
    const d = r[dCols['Due Date']];
    return d instanceof Date && Utilities.formatDate(d, tz, "yyyy-MM-dd") === todayFmt;
  }).map(r => dispIdx.map(i => r[i] || ""));

  const prioOrder = { 'P1': 1, 'P2': 2, 'P3': 3, 'P4': 4 };
  const prioIdx = validHeaders.indexOf("Priority");
  if (prioIdx >= 0) {
    todayTasks.sort((a, b) => (prioOrder[String(a[prioIdx]).split(":")[0]] || 99) - (prioOrder[String(b[prioIdx]).split(":")[0]] || 99));
  }

  if (todayTasks.length > 0) {
    dashboard.getRange(row, 1, 1, validHeaders.length).setValues([validHeaders]).setFontWeight("bold").setBackground("#cfe2f3");
    row++;
    dashboard.getRange(row, 1, todayTasks.length, validHeaders.length).setValues(todayTasks);
    row += todayTasks.length;
  } else {
    dashboard.getRange(row, 1).setValue("No tasks due today.").setFontStyle("italic");
    row++;
  }

  row += 2;
  createQuadrantsOnDashboard(dashboard, dailyLog);

  createGoalProgressChart();
  createPriorityDistributionGraph();
  createCompletionRateGraph();
}

