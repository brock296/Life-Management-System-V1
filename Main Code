function removeCompletedTasks() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const dailyLog = ss.getSheetByName(DAILY_LOG_SHEET_NAME);
  if (!dailyLog) return;
  const dCols = getColumnMap(dailyLog);
  const sCol = dCols['Status'];
  if (sCol === undefined) return;
  const lr = findLastDataRow(dailyLog);
  if (lr <= 1) return;
  const data = dailyLog.getRange(2, 1, lr - 1, dailyLog.getLastColumn()).getValues();
  const toDel = [];
  data.forEach((r, i) => { if (String(r[sCol]).trim() === "✅ Done") toDel.push(i + 2); });
  toDel.reverse().forEach(r => dailyLog.deleteRow(r));
  if (toDel.length > 0) Logger.log(`Removed ${toDel.length} completed tasks.`);
}

