// ==========================================================================
//                           UTILITY FUNCTIONS
// ==========================================================================

function getColumnMap(sheet) {
  const cacheKey = sheet.getSheetId() + "_columnMap_v2";
  const cached = SCRIPT_CACHE.get(cacheKey);
  if (cached) return JSON.parse(cached);
  const headers = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0];
  const map = {};
  headers.forEach((h, i) => {
    if (h) {
      const key = String(h).trim();
      if (map[key] === undefined) map[key] = i;   // first occurrence wins
    }
  });
  SCRIPT_CACHE.put(cacheKey, JSON.stringify(map), 21600);
  return map;
}

function getSheetDataSafe(sheet) {
  const lr = sheet.getLastRow();
  const lc = sheet.getLastColumn();
  if (lr < 2 || lc < 1) return [];
  return sheet.getRange(2, 1, lr - 1, lc).getValues();
}

function findLastDataRow(sheet) {
  const lr = sheet.getLastRow();
  if (lr === 0) return 0;
  const vals = sheet.getRange(1, 1, lr, 1).getValues();
  for (let i = vals.length - 1; i >= 0; i--) {
    if (vals[i][0] && String(vals[i][0]).trim() !== "") return i + 1;
  }
  return 0;
}

function getNextEmptyRow(sheet) {
  return sheet.getLastRow() + 1;
}

function getDropdownOptions(listsSheet) {
  if (!listsSheet) return {};
  const lr = listsSheet.getLastRow();
  const lc = listsSheet.getLastColumn();
  if (lr <= 1 || lc === 0) return {};
  const headers = listsSheet.getRange(1, 1, 1, lc).getValues()[0];
  const data = listsSheet.getRange(2, 1, lr - 1, lc).getValues();
  const options = {};
  headers.forEach((h, i) => {
    const key = String(h).trim();
    if (key) options[key] = new Set(data.map(r => String(r[i] || "").trim()).filter(Boolean));
  });
  return options;
}

function validateAndGetValue(value, columnName, dropdownOptions) {
  if (!value) return "";
  const str = String(value).trim();
  return dropdownOptions[columnName]?.has(str) ? str : "";
}

function parseDate(value) {
  if (value instanceof Date) return value;
  if (typeof value === 'string' && value.trim() !== '') {
    const d = new Date(value);
    if (!isNaN(d.getTime())) return d;
  }
  return null;
}

function colorDailyLogRowInternal(row, cols) {
  const status = String(row[cols['Status']] || "").trim();
  const priority = String(row[cols['Priority']] || "").trim();
  const carry = row[cols['Carry Over?']] === true;
  let color = null;
  if (carry) color = '#ff0000';
  else if (status === "Blocked") color = '#ff3300';
  else if (status === "Waiting") color = '#ff9900';
  else if (status === "In Progress") color = '#66ccff';
  else if (status === "To Do") color = '#ffffcc';
  else if (status === "✅ Done") color = '#ccffcc';
  else if (priority.includes('P1') || priority.includes('Critical')) color = '#ff6666';
  else if (priority.includes('P2') || priority.includes('High')) color = '#ffcc99';
  else if (priority.includes('P3') || priority.includes('Medium')) color = '#ffff99';
  else if (priority.includes('P4') || priority.includes('Low')) color = '#ccffcc';
  return { colored: !!color, color };
}

