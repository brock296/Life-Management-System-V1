function reorderDailyLogByCarryOver() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const dailyLog = ss.getSheetByName(DAILY_LOG_SHEET_NAME);
  if (!dailyLog) return;
  const dCols = getColumnMap(dailyLog);
  const carryCol = dCols['Carry Over?'];
  const dateCol = dCols['Date Added'];
  if (carryCol === undefined || dateCol === undefined) return;
  const lr = findLastDataRow(dailyLog);
  if (lr <= 1) return;
  const data = dailyLog.getRange(2, 1, lr - 1, dailyLog.getLastColumn()).getValues();
  data.sort((a, b) => {
    if (a[carryCol] !== b[carryCol]) return b[carryCol] - a[carryCol];
    const aD = a[dateCol] instanceof Date ? a[dateCol].getTime() : 0;
    const bD = b[dateCol] instanceof Date ? b[dateCol].getTime() : 0;
    return bD - aD;
  });
  dailyLog.getRange(2, 1, data.length, data[0].length).setValues(data);
  enhanceDailyLogColors();
}

