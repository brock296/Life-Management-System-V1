function enhanceMasterSheetColors() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const master = ss.getSheetByName(MASTER_PROJECT_TRACKER_SHEET_NAME);
  if (!master) return;
  const mCols = getColumnMap(master);
  const mData = getSheetDataSafe(master);
  const today = new Date();
  const bg = mData.map(row => {
    const status = String(row[mCols['Status']] || "").trim();
    const added = row[mCols['Date Added']];
    let color = '#ffffff';
    if (status === "✅ Done") color = '#ccffcc';
    else if (added instanceof Date) {
      const days = Math.floor((today - added) / (1000 * 60 * 60 * 24));
      if (days > 60) color = '#cc0000';
      else if (days > 30) color = '#ff6666';
      else if (days > 14) color = '#ffcc00';
      else if (days > 7) color = '#66ccff';
      else if (days > 2) color = '#ccccff';
    } else color = '#f0f0f0';
    return new Array(master.getLastColumn()).fill(color);
  });
  if (bg.length > 0) master.getRange(2, 1, bg.length, bg[0].length).setBackgrounds(bg);
}

function enhanceDailyLogColors() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const dailyLog = ss.getSheetByName(DAILY_LOG_SHEET_NAME);
  if (!dailyLog) return;
  const dCols = getColumnMap(dailyLog);
