    return new Array(dailyLog.getLastColumn()).fill(color);
  });
  if (bg.length > 0) dailyLog.getRange(2, 1, bg.length, bg[0].length).setBackgrounds(bg);
}

function applyAestheticTheme(sheetName) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName(sheetName);
  if (!sheet) return;
  let hc = '#d9ead3';
  if (sheetName.includes("Mood") || sheetName === DAILY_LOG_SHEET_NAME) hc = '#ffcccc';
  else if (sheetName === GOALS_SHEET_NAME) hc = '#cce5ff';
  else if (sheetName === "Brain Dump") hc = '#fff2cc';

  const lc = sheet.getLastColumn();
  const lr = sheet.getLastRow();
  if (lc > 0) sheet.getRange(1, 1, 1, lc).setBackground(hc).setFontWeight("bold").setFontColor("#333333").setHorizontalAlignment("center");
  if (lr > 1) {
    const bgs = [];
    for (let r = 2; r <= lr; r++) bgs.push(new Array(lc).fill(r % 2 === 0 ? '#f3f3f3' : null));
    sheet.getRange(2, 1, bgs.length, lc).setBackgrounds(bgs);
  }
  sheet.autoResizeColumns(1, lc);
}

function formatListsSheet() {
