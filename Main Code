    ['Critical', '#ff6666'], ['High', '#ffcc99'], ['Medium', '#ffff99'], ['Low', '#ccffcc']
  ];
  sheet.getRange(3, 1).setValue("DAILY LOG COLORS").setFontWeight("bold");
  sheet.getRange(4, 1, dailyColors.length, 2).setValues(dailyColors);
  dailyColors.forEach((c, i) => sheet.getRange(i + 4, 1, 1, 2).setBackground(c[1]));

  const masterColors = [
    ['Completed', '#ccffcc'], ['>60 days old', '#cc0000'], ['>30 days', '#ff6666'],
    ['>14 days', '#ffcc00'], ['>7 days', '#66ccff'], ['>2 days', '#ccccff'],
    ['<2 days', '#ffffff'], ['No date', '#f0f0f0']
  ];
  const startRow = dailyColors.length + 6;
  sheet.getRange(startRow, 1).setValue("MASTER SHEET COLORS").setFontWeight("bold");
  sheet.getRange(startRow + 1, 1, masterColors.length, 2).setValues(masterColors);
  masterColors.forEach((c, i) => sheet.getRange(startRow + 1 + i, 1, 1, 2).setBackground(c[1]));
  sheet.autoResizeColumns(1, 2);
  SpreadsheetApp.getUi().alert("Success", "Color keys displayed!", SpreadsheetApp.getUi().ButtonSet.OK);
}
